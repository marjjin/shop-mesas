# Reemplazá estos valores con los de tu PostgreSQL local o de desarrollo.
ConnectionStrings__Restaurant=Host=localhost;Port=5432;Database=gestion_mesas;Username=postgres;Password=CHANGE_ME

# Obligatoria para una base nueva o para reemplazar el acceso heredado admin/admin.
# Elegí una contraseña privada no vacía, distinta de admin; este ejemplo se rechaza.
Authentication__AdminPassword=CHANGE_ME_TO_A_PRIVATE_PASSWORD
# Opcional: renombra la misma cuenta administradora; si se omite, conserva el nombre guardado.
# Authentication__AdminUsername=tu_usuario
# Opcional si hay varios administradores renombrados: ID existente de la cuenta que querés cambiar.
# Authentication__AdminUserId=1
Cors__AllowedOrigins__0=https://gestion-mesas-shop.vercel.app
